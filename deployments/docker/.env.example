# GoAgent Docker Environment Configuration
# Copy this file to .env and fill in your values

# ==============================================================================
# Provider Configuration
# ==============================================================================

# OpenAI (choose one provider)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Vertex AI (alternative to OpenAI)
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CREDENTIALS_PATH=./credentials/key.json
# VERTEX_LOCATION=us-central1
# VERTEX_MODEL=gemini-1.5-pro

# ==============================================================================
# Agent Configuration
# ==============================================================================

# Logging: debug, info, warn, error
LOG_LEVEL=info

# Maximum reasoning iterations before stopping
MAX_ITERATIONS=10

# Timeout in seconds (300 = 5 minutes)
TIMEOUT=300

# ==============================================================================
# Observability (Optional)
# ==============================================================================

# Enable Prometheus metrics endpoint
ENABLE_METRICS=false

# Enable OpenTelemetry tracing
ENABLE_TRACING=false

# OTLP endpoint for traces (e.g., Jaeger)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# Service name for tracing
# OTEL_SERVICE_NAME=goagent

# ==============================================================================
# Build Configuration (Optional)
# ==============================================================================

# Version tag for built images
VERSION=dev
